 ALenum ALWrapper::generate_effect(ALsizei n, ALuint *effects, const std::string& context_name) {
+  if (!efx_available) {
+    // No audio device: there is nothing to generate a real handle for.
+    std::fill(effects, effects + n, 0);
+    return AL_NO_ERROR;
+  }
   clean_errors();
   alGenEffects(n, effects);
   return check_for_errors("Generating " + std::to_string(n) + " effect for " + context_name);
 }
 
