 #include "solarus/core/Debug.h"
+#include <algorithm>
 #include <sstream>
 
 namespace Solarus {
@@ -38,6 +39,13 @@ static LPALGENFILTERS alGenFilters;
 static LPALFILTERI alFilteri;
 static LPALFILTERF alFilterf;
 
+/**
+ * Whether init_efx_system() has run and the EFX function pointers above are
+ * safe to call. Stays \c false when the engine runs with no audio device
+ * (e.g. the -no-audio command-line option, or no device found).
+ */
+static bool efx_available = false;
+
 /**
  * Init the EFX effect system by retrieving procedure pointers
  */
@@ -52,6 +60,28 @@ void ALWrapper::init_efx_system() {
   alGenFilters = (LPALGENFILTERS)alGetProcAddress("alGenFilters");
   alFilteri    = (LPALFILTERI)alGetProcAddress("alFilteri");
   alFilterf    = (LPALFILTERF)alGetProcAddress("alFilterf");
+
+  // mojoAL (PS4) has no EFX: alGetProcAddress() returns NULL for every
+  // EFX name, so only report EFX as available when every pointer was
+  // actually retrieved. Otherwise the first audio effect would call a
+  // NULL function pointer. With EFX off, the effect wrappers below bail
+  // out safely and quests run with plain audio.
+  efx_available = alGenEffects != nullptr && alDeleteEffects != nullptr &&
+                  alEffecti != nullptr && alEffectf != nullptr &&
+                  alGenAuxiliaryEffectSlots != nullptr &&
+                  alAuxiliaryEffectSloti != nullptr && alGenFilters != nullptr &&
+                  alFilteri != nullptr && alFilterf != nullptr;
+}
+
+/**
+ * \brief Returns whether the EFX functions above have been initialized and
+ * are safe to call.
+ * \return \c false when running with no audio device (e.g. -no-audio, or no
+ * device found): calling the EFX functions in that case would call a null
+ * function pointer.
+ */
+bool ALWrapper::is_efx_available() {
+  return efx_available;
 }
 
