diff --git a/CMakeLists.txt b/CMakeLists.txt
index be1b4f8..039507a 100644
--- a/CMakeLists.txt
+++ b/CMakeLists.txt
@@ -2420,6 +2420,71 @@ elseif (PS4)
   CheckLibSampleRate()
 endif()
 
+# PS4: our toolchain sets CMAKE_SYSTEM_NAME PS4 and the PS4 platform file
+# sets UNIX=1, so SDLs platform chain takes the UNIX branch and skips the
+# elseif (PS4) block above. Force the PS4 drivers here when PS4 is set and
+# they were not already configured (guarded, so no duplication if the
+# elseif block ever does run).
+if (PS4 AND NOT SDL_VIDEO_DRIVER_PS4)
+  if (SDL_AUDIO)
+    set(SDL_AUDIO_DRIVER_PS4 1)
+    file(GLOB PS4_AUDIO_SOURCES ${SDL2_SOURCE_DIR}/src/audio/ps4/*.c)
+    set(SOURCE_FILES ${SOURCE_FILES} ${PS4_AUDIO_SOURCES})
+    set(HAVE_SDL_AUDIO TRUE)
+  endif ()
+  if (SDL_FILESYSTEM)
+    set(SDL_FILESYSTEM_PS4 1)
+    file(GLOB PS4_FILESYSTEM_SOURCES ${SDL2_SOURCE_DIR}/src/filesystem/ps4/*.c)
+    set(SOURCE_FILES ${SOURCE_FILES} ${PS4_FILESYSTEM_SOURCES})
+    set(HAVE_SDL_FILESYSTEM TRUE)
+  endif ()
+  if (SDL_JOYSTICK)
+    set(SDL_JOYSTICK_PS4 1)
+    file(GLOB PS4_JOYSTICK_SOURCES ${SDL2_SOURCE_DIR}/src/joystick/ps4/*.c)
+    set(SOURCE_FILES ${SOURCE_FILES} ${PS4_JOYSTICK_SOURCES})
+    set(HAVE_SDL_JOYSTICK TRUE)
+  endif ()
+  if (SDL_POWER)
+    #set(SDL_POWER_PS4 1)
+    #file(GLOB PS4_POWER_SOURCES ${SDL2_SOURCE_DIR}/src/power/ps4/*.c)
+    #set(SOURCE_FILES ${SOURCE_FILES} ${PS4_POWER_SOURCES})
+    #set(HAVE_SDL_POWER TRUE)
+  endif ()
+  if (SDL_TIMERS)
+    set(SDL_TIMER_UNIX 1)
+    file(GLOB TIMER_SOURCES ${SDL2_SOURCE_DIR}/src/timer/unix/*.c)
+    set(SOURCE_FILES ${SOURCE_FILES} ${TIMER_SOURCES})
+    set(HAVE_SDL_TIMERS TRUE)
+  endif ()
+  if (SDL_VIDEO)
+    set(SDL_VIDEO_DRIVER_PS4 1)
+    file(GLOB PS4_VIDEO_SOURCES
+            ${SDL2_SOURCE_DIR}/src/video/ps4/*.c
+            ${SDL2_SOURCE_DIR}/src/video/ps4/shaders/*.c
+            )
+    set(SOURCE_FILES ${SOURCE_FILES} ${PS4_VIDEO_SOURCES})
+    set(HAVE_SDL_VIDEO TRUE)
+    set(SDL_VIDEO_OPENGL_EGL 1)
+    set(SDL_VIDEO_OPENGL_ES2 1)
+    set(SDL_VIDEO_RENDER_OGL_ES2 1)
+    set(HAVE_OPENGLES TRUE)
+  endif ()
+  set(SDL_LIBSAMPLERATE ON)
+  set(SDL_LIBSAMPLERATE_SHARED OFF)
+  set(SDL_STATIC_PIC ON)
+  set(HAVE_CLOCK_GETTIME 0)
+  set(SDL_LIBS "") # remove duplicate not working (for sdl2.pc) ?
+  set(EXTRA_LDFLAGS "") # remove duplicate not working (for sdl2.pc) ?
+  list(APPEND EXTRA_CFLAGS "-D__PS4__ -DSDL_VIDEO_STATIC_ANGLE")
+  list(APPEND EXTRA_LIBS
+          SDL2
+          SceSystemService SceSysUtil SceSysmodule
+          SceUserService SceAudioOut ScePad ScePigletv2VSH
+          )
+  CheckPTHREAD()
+  CheckLibSampleRate()
+endif()
+
 if(SDL_VULKAN AND NOT SDL_LOADSO)
   message(STATUS "Vulkan support is available, but disabled because there's no loadso.")
   set(SDL_VULKAN OFF)
